{
  "name": "tcc-test-generation-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do projeto de geração de casos de teste com IA generativa.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/research/migrate.js",
    "worker": "node src/research/worker.js",
    "smoke:gemini": "node scripts/smoke-gemini.js",
    "test": "node --test --test-concurrency=1 test",
    "test:integration": "node --test --test-concurrency=1 test/integration"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "acorn": "8.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pdfjs-dist": "5.5.207",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
